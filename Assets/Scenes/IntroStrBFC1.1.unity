--- !u!114 &1518699245
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1518699244}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7aea6480ea6c9a34cb14337f12f8fac3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  manHinhDen: {fileID: 421701847}
  textHienThi: {fileID: 1720504878}
  nguonPhatAm: {fileID: 1518699246}
  cacThanhPhanIntroCu:
  - {fileID: 1891107982}
  - {fileID: 1397996022}
  - {fileID: 552408338}
  tocDoGoChu: 0.03
  danhSachLoiDan:
  - noiDung: "Ng\u01B0\u1EDDi ta th\u01B0\u1EDDng n\xF3i, ngh\u1EC1 ch\u1ECDn ng\u01B0\u1EDDi,
      nh\u01B0ng v\u1EDBi cha t\xF4i... c\xF3 l\u1EBD l\xE0 'nghi\u1EC7p' ch\u1ECDn
      ng\u01B0\u1EDDi."
    giongDoc: {fileID: 8300000, guid: 218eb91a2873c9440b9543d00fcce9bc, type: 3}
    thoiGianCho: 1
  - noiDung: "Cha t\xF4i l\xE0 m\u1ED9t Th\u1EA7y Ph\xE1p. C\u1EA3 \u0111\u1EDDi
      \xF4ng l\u1EA7m l\u0169i trong c\u0103n nh\xE0 g\u1ED7 t\u1ED1i t\u0103m, t\u1EC9
      m\u1EA9n kh\xE2u v\xE1 nh\u1EEFng con h\xECnh nh\xE2n b\u1EB1ng v\u1EA3i, b\u1EB1ng
      da  v\xE0 c\xE1c h\xECnh nh\xE2n gi\u1EA5y, b\xF9a ng\u1EA3i... \xD4ng b\u1EA3o
      \u0111\xF3 l\xE0 b\xF9a h\u1ED9 m\u1EC7nh cho ng\u01B0\u1EDDi gi\xE0u, gi\xFAp
      h\u1ECD tai qua n\u1EA1n kh\u1ECFi."
    giongDoc: {fileID: 0}
    thoiGianCho: 1
  - noiDung: "Nh\u01B0ng t\xF4i ch\u01B0a bao gi\u1EDD th\u1EA5y cha c\u01B0\u1EDDi.
      Tr\xEAn ng\u01B0\u1EDDi \xF4ng l\xFAc n\xE0o c\u0169ng n\u1ED3ng n\u1EB7c m\xF9i
      r\u01B0\u1EE3u ng\xE2m, m\xF9i nhang kh\xF3i v\xE0... m\u1ED9t m\xF9i tanh
      n\u1ED3ng l\u1EE3m gi\u1ECDng m\xE0 ng\xE0y b\xE9 t\xF4i kh\xF4ng hi\u1EC3u
      l\xE0 g\xEC."
    giongDoc: {fileID: 8300000, guid: 218eb91a2873c9440b9543d00fcce9bc, type: 3}
    thoiGianCho: 1
  - noiDung: "Ng\xE0y t\xF4i r\u1EDDi \u0111i h\u1ECDc \u0111\u1EA1i h\u1ECDc, cha
      d\xFAi v\xE0o tay t\xF4i m\u1ED9t l\xE1 b\xF9a \u0111\u1ECF ch\xF3t, \xE1nh
      m\u1EAFt \xF4ng h\u1EB1n l\xEAn nh\u1EEFng tia m\xE1u \u0111\u1ECF qu\u1EA1ch,
      gi\u1ECDng l\u1EA1c \u0111i nh\u01B0 ng\u01B0\u1EDDi c\xF5i \xE2m:"
    giongDoc: {fileID: 8300000, guid: 218eb91a2873c9440b9543d00fcce9bc, type: 3}
    thoiGianCho: 1
  - noiDung: "'Linh! Nghe cha d\u1EB7n. N\u1EBFu cha s\u1ED1ng qua 80 tu\u1ED5i m\xE0
      m\u1EA5t, con h\xE3y v\u1EC1 lo h\u1EADu s\u1EF1. Nh\u01B0ng n\u1EBFu cha ch\u1EBFt
      b\u1EA5t \u0111\u1EAFc k\u1EF3 t\u1EED tr\u01B0\u1EDBc tu\u1ED5i 80... th\xEC
      tuy\u1EC7t \u0111\u1ED1i kh\xF4ng \u0111\u01B0\u1EE3c quay tr\u1EDF v\u1EC1
      Th\xF4n T\u1ECBch T\xE0. Nh\u1EDB ch\u01B0a! D\xF9 c\xF3 tin b\xE1o, d\xF9
      c\xF3 nh\u1EDB th\u01B0\u01A1ng... c\u0169ng c\u1EA5m \u0111\u01B0\u1EE3c b\u01B0\u1EDBc
      ch\xE2n qua c\u1ED5ng l\xE0ng! Ch\u1EA1y \u0111i! Ch\u1EA1y c\xE0ng xa c\xE0ng
      t\u1ED1t!'"
    giongDoc: {fileID: 8300000, guid: 218eb91a2873c9440b9543d00fcce9bc, type: 3}
    thoiGianCho: 1
  - noiDung: "N\u0103m nay... cha t\xF4i m\u1EDBi 58 tu\u1ED5i."
    giongDoc: {fileID: 8300000, guid: 218eb91a2873c9440b9543d00fcce9bc, type: 3}
    thoiGianCho: 1
  - noiDung: "B\u1EE9c th\u01B0 b\xE1o t\u1EED g\u1EEDi \u0111\u1EBFn tay t\xF4i
      s\xE1ng nay ch\u1EC9 v\u1ECFn v\u1EB9n v\xE0i ch\u1EEF ngu\u1EC7ch ngo\u1EA1c:
      'Th\u1EA7y Ph\xE1p ch\u1EBFt r\u1ED3i. M\u1EA5t h\u1EBFt n\u1ED9i t\u1EA1ng.
      V\u1EC1 g\u1EA5p.'"
    giongDoc: {fileID: 8300000, guid: 218eb91a2873c9440b9543d00fcce9bc, type: 3}
    thoiGianCho: 1
  - noiDung: "L\u1EDDi th\u1EC1 n\u0103m x\u01B0a v\u0103ng v\u1EB3ng b\xEAn tai,
      nh\u01B0ng l\xE0m sao con c\xF3 th\u1EC3 kh\xF4ng v\u1EC1 h\u1EA3 cha? M\u1ED9t
      m\xECnh cha n\u1EB1m l\u1EA1i l\u1EA1nh l\u1EBDo n\u01A1i \u0111\xF3... Con
      xin l\u1ED7i. D\xF9 Th\xF4n T\u1ECBch T\xE0 c\xF3 l\xE0 hang h\xF9m mi\u1EC7ng
      s\xF3i, con c\u0169ng ph\u1EA3i v\u1EC1 g\u1EB7p cha... l\u1EA7n cu\u1ED1i
      c\xF9ng.\""
    giongDoc: {fileID: 8300000, guid: 218eb91a2873c9440b9543d00fcce9bc, type: 3}
    thoiGianCho: 1
