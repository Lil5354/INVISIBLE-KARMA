--- !u!114 &1891107983
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1891107982}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3273633728d98034cbea7f1cdede8bc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  nameText: {fileID: 732284592}
  contentText: {fileID: 937937318}
  nameContainer: {fileID: 0}
  voiceSource: {fileID: 0}
  sfxSource: {fileID: 0}
  typingSound: {fileID: 8300000, guid: 18705229368c95f4faa14d268246ea16, type: 3}
  typingFrequency: 4
  typingSpeed: 0.05
  gameplaySceneName: Chapter1
  storyLines:
  - characterName: 
    content: "Gi\xF3 \u0111\xEAm r\xEDt t\u1EEBng c\u01A1n l\u1EA1nh bu\u1ED1t. Nh\u1EEFng
      \u0111\u1ED3ng ti\u1EC1n v\xE0ng m\xE3 b\u1ECB cu\u1ED1n bay t\u1EE9 tung,
      xoay v\xF2ng trong \xE1nh \u0111\xE8n l\u1ED3ng \u0111\u1ECF qu\u1EA1ch nh\u01B0
      m\u1ED9t \u0111\xE1m tang kh\xF4ng ng\u01B0\u1EDDi."
    isNarration: 0
    voiceClip: {fileID: 8300000, guid: 62173ba6238a5854092a44cb87da1dd1, type: 3}
  - characterName: 
    content: "Linh b\u01B0\u1EDBc xu\u1ED1ng xe. C\xF4 tuy\u1EC7t v\u1ECDng gi\u01A1
      cao chi\u1EBFc \u0111i\u1EC7n tho\u1EA1i, nh\u01B0ng d\xF2ng ch\u1EEF 'No Signal'
      nh\u1EA5p nh\xE1y .."
    isNarration: 0
    voiceClip: {fileID: 8300000, guid: 62173ba6238a5854092a44cb87da1dd1, type: 3}
  - characterName: 'LINH: '
    content: "Cha \u01A1i... Cu\u1ED1i c\xF9ng con c\u0169ng v\u1EC1 l\u1EA1i n\u01A1i
      n\xE0y, sao m\u1ECDi th\u1EE9 l\u1EA1i l\u1EA1nh tanh th\u1EBF n\xE0y?....
      M\u1ECDi ng\u01B0\u1EDDi \u0111i \u0111\xE2u h\u1EBFt r\u1ED3i?"
    isNarration: 0
    voiceClip: {fileID: 8300000, guid: fc3122373b3594f4fae17c5c66764d7b, type: 3}
  - characterName: 
    content: "Linh \u0111i s\xE2u v\xE0o trong th\xF4n. Kh\xF4ng m\u1ED9t b\xF3ng
      ng\u01B0\u1EDDi s\u1ED1ng. C\u1EEDa c\xE1c ng\xF4i nh\xE0 g\u1ED7 \u0111\u1EC1u
      \u0111\xF3ng im \u1EC9m, then c\xE0i ch\u1EB7t nh\u01B0 s\u1EE3 h\xE3i m\u1ED9t
      th\u1EE9 g\xEC \u0111\xF3 t\u1EEB b\xEAn ngo\xE0i"
    isNarration: 0
    voiceClip: {fileID: 8300000, guid: 62173ba6238a5854092a44cb87da1dd1, type: 3}
  - characterName: 
    content: "...Ch\u1EC9 c\xF3 nh\u1EEFng h\xE0ng m\xE3 \u0111\u01B0\u1EE3c b\xE0y
      la li\u1EC7t. Ng\u1EF1a gi\u1EA5y, xe tang, v\xE0 nh\u1EEFng h\xECnh nh\xE2n
      th\u1EBF m\u1EA1ng \u0111\u1EE9ng r\u0169 r\u01B0\u1EE3i... \u0111\xF4i m\u1EAFt
      ch\u1EA5m m\u1EF1c \u0111en v\xF4 h\u1ED3n nh\u01B0 \u0111ang d\xF5i theo t\u1EEBng
      b\u01B0\u1EDBc ch\xE2n c\u1EE7a c\xF4."
    isNarration: 0
    voiceClip: {fileID: 8300000, guid: 9c93311c296bbdc428f227b8e1493d55, type: 3}
  - characterName: 
    content: "S\u1EF1 im l\u1EB7ng bao tr\xF9m \u0111\u1EBFn m\u1EE9c Linh c\xF3
      th\u1EC3 nghe th\u1EA5y ti\u1EBFng tim m\xECnh \u0111\u1EADp th\xECnh th\u1ECBch"
    isNarration: 0
    voiceClip: {fileID: 8300000, guid: c774cd60e15af9643840d8d85e41362d, type: 3}
  - characterName: 
    content: "Ph\xEDa tr\u01B0\u1EDBc l\xE0 R\u1EEBng Tr\xFAc. \xC1nh tr\u0103ng
      r\u1EB1m soi r\xF5 con \u0111\u01B0\u1EDDng \u0111\u1ED9c \u0111\u1EA1o...
      C\xF4 b\u1EAFt bu\u1ED9c ph\u1EA3i \u0111i qua n\xF3."
    isNarration: 0
    voiceClip: {fileID: 8300000, guid: 62173ba6238a5854092a44cb87da1dd1, type: 3}
